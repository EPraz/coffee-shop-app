{
  "name": "bruma-cafe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["server"],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43174 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "playwright test",
    "test:api": "playwright test --config playwright.api.config.ts",
    "api:dev": "npm run dev --workspace server",
    "api:build": "npm run build --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "test:ui": "playwright test --ui",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "walkthrough:rehearse": "node scripts/walkthrough/record.mjs --rehearsal",
    "walkthrough:record": "node scripts/walkthrough/record.mjs",
    "walkthrough:render": "python scripts/walkthrough/render.py"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "i18next": "^26.7.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
