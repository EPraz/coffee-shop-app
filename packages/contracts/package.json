{
  "name": "@bruma/contracts",
  "private": true,
  "version": "3.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "node ../../scripts/clean-build.mjs contracts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./orders": {
      "types": "./dist/orders.d.ts",
      "default": "./dist/orders.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "default": "./dist/dashboard.js"
    }
  }
}
