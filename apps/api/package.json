{
  "name": "@bruma/api",
  "private": true,
  "version": "3.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node ../../scripts/clean-build.mjs api && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "6.19.3",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12",
    "@bruma/contracts": "*"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "prisma": "6.19.3",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
