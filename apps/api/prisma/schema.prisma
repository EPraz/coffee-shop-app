generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id         String @id
  generation String
}

model Coffee {
  id        String    @id
  available Boolean
  price250  Int
  price500  Int
  version   Int       @default(1)
  variants  Variant[]
}

model Variant {
  id          String @id
  coffeeId    String
  weight      Int
  preparation String
  stock       Int
  coffee      Coffee @relation(fields: [coffeeId], references: [id])

  @@unique([coffeeId, weight, preparation])
}

model Order {
  number      String      @id
  createdAt   DateTime    @default(now())
  example     Boolean     @default(false)
  state       String      @default("confirmed")
  version     Int         @default(1)
  buyerHash   String
  requestKey  String
  requestHash String
  subtotal    Int
  discount    Int
  shipping    Int
  total       Int
  items       OrderItem[]

  @@unique([buyerHash, requestKey])
  @@index([createdAt])
}

model OrderItem {
  id          String @id @default(uuid())
  orderNumber String
  coffeeId    String
  weight      Int
  preparation String
  quantity    Int
  unitPrice   Int
  discount    Int
  coffee      Json
  order       Order  @relation(fields: [orderNumber], references: [number], onDelete: Cascade)
}
